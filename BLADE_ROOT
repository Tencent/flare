# vcpkg-provided third-party libraries (issue blade-build#1236). Hands-on
# migration of thirdparty/ libs to vcpkg; consumers keep using //thirdparty/X:Y
# (those BUILD files are thin wrappers over vcpkg#port:lib). Versions are pinned
# to match the previously vendored sources.
vcpkg_config(
    baseline = '06a7fdd564234908731c59ac46a624f808e87b1c',
    root = '/Volumes/code/vcpkg',
    packages = {
        # 3.21.12: the last protobuf release before v22 made Abseil a hard
        # dependency. flare's source predates the descriptor name()->string_view
        # change (v23+), so it builds against 3.21.
        'protobuf': {'version': '3.21.12'},
        'fmt': '7.1.3',
        # gflags/glog are singletons (global flag registry; glog registers flags
        # like logtostderr in gflags). linkage='auto': the static .a is always
        # built and the shared lib is built on demand for dynamic_link binaries.
        # A dynamic_link release exe shares one .dylib (no duplicate
        # registration); a static build-time tool (the protoc plugins, set
        # dynamic_link=False) links a self-contained .a with no @rpath dylib to
        # resolve. link_all_symbols whole-archives that static .a so the flag
        # registration initializers survive even when unreferenced.
        'gflags': {'version': '2.2.2', 'linkage': 'auto',
                   'link_all_symbols': True},
        # flare includes "glog/logging.h" -- vcpkg's native layout, no remap.
        # GFLAGS_NOTHREADS=OFF: with a *static* gflags, gflags-config.cmake has a
        # template bug (it tests an unsubstituted `PACKAGE_NAME@_static` target)
        # and defaults GFLAGS_NOTHREADS=TRUE, so glog's find_package(gflags) asks
        # for the nonexistent gflags_nothreads_static. Forcing it OFF picks the
        # built gflags_static (glog uses Threads anyway).
        'glog': {'version': '0.7.1', 'linkage': 'auto', 'link_all_symbols': True,
                 'cmake_options': ['-DGFLAGS_NOTHREADS=OFF']},
        # Static-safe data/compression libs. flare includes them as
        # "<lib>/<header>" but vcpkg ships at include/ top level, so each needs
        # include_prefix. Versions follow the baseline (these are ABI-stable).
        'zlib': {'include_prefix': 'zlib'},
        'lz4': {'include_prefix': 'lz4'},
        'zstd': {'include_prefix': 'zstd'},
        # vcpkg's snappy forces -fno-rtti unless SNAPPY_WITH_RTTI is set; flare
        # uses RTTI on snappy::Sink/Source.
        'snappy': {'include_prefix': 'snappy',
                   'cmake_options': ['-DSNAPPY_WITH_RTTI=ON']},
        'xxhash': {'include_prefix': 'xxhash'},
        # yaml-cpp ships at vcpkg's native include/yaml-cpp/ layout, which
        # already matches how flare includes it -- no include_prefix.
        # yaml-cpp is pulled into a dynamic_link lib (flare/base/monitoring:init,
        # built as a .dylib). linkage='auto' builds the on-demand shared yaml-cpp
        # (the old foreign build was shared too); link_all_symbols whole-archives
        # the static .a into the wrapper's .dylib so it actually exports the
        # yaml-cpp symbols the consumer needs (the wrapper has no srcs of its own).
        'yaml-cpp': {'linkage': 'auto', 'link_all_symbols': True},
    },
)
