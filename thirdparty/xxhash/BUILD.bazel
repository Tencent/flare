# xxhash is fetched from upstream for Bazel (see //bazel:deps.bzl); this alias
# keeps the //thirdparty/xxhash:xxhash label stable for consumers
# (flare/base/experimental). The in-tree source was removed when the blade
# build moved to vcpkg (//thirdparty/xxhash/BUILD wraps vcpkg#xxhash:xxhash).
alias(
    name = "xxhash",
    actual = "@com_github_cyan4973_xxhash//:xxhash",
    visibility = ["//visibility:public"],
)
